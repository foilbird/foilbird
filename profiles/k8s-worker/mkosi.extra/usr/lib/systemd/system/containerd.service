# SPDX-License-Identifier: Apache-2.0
# Based on containerd's upstream unit (containerd/containerd containerd.service); config from /usr, state on /var.
[Unit]
Description=containerd container runtime
Documentation=https://containerd.io
After=network.target local-fs.target dbus.service var.mount
RequiresMountsFor=/var/lib/containerd

[Service]
ExecStartPre=-/usr/sbin/modprobe overlay
ExecStart=/usr/bin/containerd --config /usr/lib/foilbird/containerd/config.toml
Type=notify
Delegate=yes
KillMode=process
Restart=always
RestartSec=5
LimitNPROC=infinity
LimitCORE=infinity
TasksMax=infinity
OOMScoreAdjust=-999

[Install]
WantedBy=multi-user.target
