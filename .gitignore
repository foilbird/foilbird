# Python bytecode of the build tools
__pycache__/
# Signing keys never go into git
mkosi.key
mkosi.crt
*.key
*.pem
# Build outputs
mkosi.output/
mkosi.cache/
out*/
*.raw
*.efi
*.initrd
*.vmlinuz
# mkosi initrd outputs only (initrd, initrd.cpio.zst); a bare initrd* also hid initrd-*.target.wants/ in the
# source trees (the foil-machine-id.service link once never reached git)
initrd
initrd.*
# Generated by images/debian/tools/apt-pin.py prepare (verified downloaded inputs, not sources)
pinned.conf
apt-pin-inputs.json
aptpin/
nvsrc/
apt-cache/
nvidia-cache/
# Verified downloads of tools/fetch-upstream.py (build inputs)
upstream/
