# SPDX-License-Identifier: Apache-2.0
[Unit]
Description=Render node configuration (foilbird)
Documentation=https://github.com/foilbird/foilbird/tree/main/api
DefaultDependencies=no
After=local-fs.target systemd-tmpfiles-setup.service boot.automount
Before=systemd-networkd.service systemd-timesyncd.service network-pre.target sysinit.target shutdown.target
Wants=network-pre.target
Conflicts=shutdown.target

[Service]
# PoC: no shell on the node; the console is the only log channel besides the API.
StandardOutput=journal+console
StandardError=journal+console
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/bin/foil-agent apply-boot
# Bridge (TEST only): plain files in /boot/loader/foilbird/<name> on the ESP, read only;
# systemd credentials (SMBIOS, kernel command line) as the second source.
ImportCredential=node.*
ImportCredential=k8s.*
# sethostname(2) needs CAP_SYS_ADMIN; nothing else.
CapabilityBoundingSet=CAP_SYS_ADMIN
AmbientCapabilities=
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/run/foilbird -/run/systemd/network -/run/systemd/timesyncd.conf.d
ReadOnlyPaths=-/var/lib/foil-agent
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
PrivateNetwork=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=no
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service sethostname
SystemCallErrorNumber=EPERM
UMask=0022

[Install]
WantedBy=sysinit.target
