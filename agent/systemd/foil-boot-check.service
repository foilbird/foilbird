# Health gate of decision 0003. With a boot counter active, boot-complete.target
# (and so systemd-bless-boot) is reached only if this unit succeeds; a failure
# reboots, and after the last try systemd-boot falls back to the other slot.
# WantedBy=multi-user.target runs it on committed entries too (no counter), so
# the agent always reports a boot confirmation result.
[Unit]
Description=Health gate before boot-complete (foilbird)
# foil-repart: on the first boot the check (and its reboot on failure) waits for the repartitioning, whatever happened to
# the units that need /var meanwhile; a reboot in the middle stopped foil-repart before it wrote the partition table and
# the next boot started over (Proxmox HDD, 2026-11-27). foil-repart is skipped on every later boot (/var exists): no wait.
After=foil-config.service foil-agent.service dbus.socket foil-repart.service
Before=boot-complete.target

[Service]
# PoC: no shell on the node; the console is the only log channel besides the API.
StandardOutput=journal+console
StandardError=journal+console
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/bin/foil-agent boot-check --timeout 300
TimeoutStartSec=330
FailureAction=reboot
CapabilityBoundingSet=
AmbientCapabilities=
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/run/foilbird
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectHostname=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service adjtimex
SystemCallFilter=~@resources
SystemCallErrorNumber=EPERM

[Install]
RequiredBy=boot-complete.target
WantedBy=multi-user.target
